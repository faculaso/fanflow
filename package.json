{
  "name": "fanflow",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first \"vite --port 5183\" \"wait-on http://localhost:5183 && cross-env ELECTRON_RUN_AS_NODE= ELECTRON_START_URL=http://localhost:5183 electron .\"",
    "build:helper": "dotnet publish hardware-helper -c Release -r win-x64 --self-contained true",
    "electron:build": "npm run build:helper && tsc -b && vite build && electron-builder"
  },
  "build": {
    "appId": "com.fanflow.app",
    "productName": "FanFlow",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "hardware-helper/bin/Release/net9.0/win-x64/publish",
        "to": "hardware-helper"
      },
      {
        "from": "build-resources/pawnio",
        "to": "pawnio"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build-resources/installer.nsh"
    }
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
